#!/bin/bash
set -e

chmod 755 /usr/sbin/krubus-runtime-tune 2>/dev/null || true

if ! ischroot 2>/dev/null; then
    # Adopt package conffiles if dpkg created .dpkg-dist due to pre-existing image files
    for cfg in \
        /etc/sysctl.d/99-krubus-pi5.conf \
        /etc/systemd/zram-generator.conf \
        /etc/systemd/journald.conf.d/99-persistent.conf \
        /etc/pipewire/pipewire.conf.d/99-krubus.conf \
        /etc/xdg/ddcutil/ddcutilrc \
        /etc/xdg/powerdevilrc \
        /etc/firefox/policies/policies.json \
        /etc/firefox-esr/policies/policies.json \
        /etc/xdg/kdeglobals \
        /etc/skel/.config/kdeglobals \
        /etc/systemd/user/plasma-powerdevil.service.d/override.conf; do
        if [ -f "${cfg}.dpkg-dist" ]; then
            mv -f "${cfg}.dpkg-dist" "$cfg"
        fi
    done

    # Update system icon cache for new krubus icons
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true

    # Ensure existing user sessions default to balanced power profile & krubus launcher icon
    for homedir in /home/*; do
        [ -d "$homedir" ] || continue
        pdf="$homedir/.config/powerdevilrc"
        if [ -f "$pdf" ] && grep -q "PowerProfile=power-saver" "$pdf"; then
            sed -i 's/PowerProfile=power-saver/PowerProfile=balanced/g' "$pdf"
        fi
        appsrc="$homedir/.config/plasma-org.kde.plasma.desktop-appletsrc"
        if [ -f "$appsrc" ] && grep -q "plugin=org.kde.plasma.kickoff" "$appsrc"; then
            python3 -c "
import configparser
cp = configparser.ConfigParser(interpolation=None)
cp.optionxform = str
cp.read('$appsrc')
mod = False
for s in cp.sections():
    if cp.has_option(s, 'plugin') and cp.get(s, 'plugin') == 'org.kde.plasma.kickoff':
        cg = s + '[Configuration][General]'
        if not cp.has_section(cg):
            cp.add_section(cg)
        if not cp.has_option(cg, 'icon') or cp.get(cg, 'icon') in ['', 'start-here-kde']:
            cp.set(cg, 'icon', 'krubus')
            mod = True
if mod:
    with open('$appsrc', 'w') as f:
        cp.write(f)
" 2>/dev/null || true
        fi
    done

    # 1. Apply kernel sysctl tweaks immediately
    sysctl --system >/dev/null 2>&1 || true

    # 2. Run runtime hardware IRQ/MGLRU tuning
    /usr/sbin/krubus-runtime-tune >/dev/null 2>&1 || true

    # 3. Reload udev rules
    udevadm control --reload 2>/dev/null || true

    # 4. Restart earlyoom with KDE Plasma crash protection
    systemctl try-restart earlyoom.service 2>/dev/null || true

    # 5. Reload journald with syslog suppression
    systemctl try-reload-or-restart systemd-journald.service 2>/dev/null || true

    # 6. Ensure MESA_DISK_CACHE_SINGLE_FILE is in /etc/environment
    if [ -f /etc/environment ] && ! grep -q "MESA_DISK_CACHE_SINGLE_FILE" /etc/environment; then
        echo "MESA_DISK_CACHE_SINGLE_FILE=1" >> /etc/environment
    fi

    # 7. Reload PipeWire in running desktop user sessions
    for bus_sock in /run/user/[0-9]*/bus; do
        [ -S "$bus_sock" ] || continue
        uid_dir="$(dirname "$bus_sock")"
        uid="$(basename "$uid_dir")"
        uname="$(id -nu "$uid" 2>/dev/null || true)"
        [ -n "$uname" ] || continue
        runuser -u "$uname" -- env \
            XDG_RUNTIME_DIR="$uid_dir" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$bus_sock" \
            systemctl --user try-restart pipewire.service >/dev/null 2>&1 || true
        runuser -u "$uname" -- env \
            XDG_RUNTIME_DIR="$uid_dir" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$bus_sock" \
            busctl --user call org.kde.Solid.PowerManagement /org/kde/Solid/PowerManagement org.kde.Solid.PowerManagement loadProfile b true >/dev/null 2>&1 || true
        runuser -u "$uname" -- env \
            XDG_RUNTIME_DIR="$uid_dir" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$bus_sock" \
            plasma-apply-colorscheme KRubusDark >/dev/null 2>&1 || true
    done

    # 8. Reload ZRAM to activate zstd algorithm and new scaling (if swap is unused)
    if [ -b /dev/zram0 ]; then
        cur_used="$(swapon --noheadings --show=USED /dev/zram0 2>/dev/null | xargs || true)"
        if [ "$cur_used" = "0B" ] || [ -z "$cur_used" ]; then
            swapoff /dev/zram0 >/dev/null 2>&1 || true
            systemctl restart systemd-zram-setup@zram0.service >/dev/null 2>&1 || true
        fi
    fi
fi

exit 0
