#!/bin/bash
set -e

mkdir -p /var/lib/rpi-power-profiles
chmod 755 /var/lib/rpi-power-profiles

if ! ischroot 2>/dev/null; then
    # Reload D-Bus policy immediately (before dpkg triggers run) so owning the bus name is allowed right away
    busctl call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig >/dev/null 2>&1 || \
        systemctl reload dbus.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    systemctl unmask rpi-power-profiles.service 2>/dev/null || true
    systemctl enable rpi-power-profiles.service 2>/dev/null || true
    systemctl restart rpi-power-profiles.service 2>/dev/null || true
else
    systemctl enable rpi-power-profiles.service 2>/dev/null || true
fi

exit 0
